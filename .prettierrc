{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "printWidth": 100,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-nunjucks"],
  "overrides": [
    {
      "files": ["*.njk", "*.nunjucks", "*.nunj"],
      "options": {
        "parser": "nunjucks"
      }
    }
  ]
}
