<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> Gabriel Romay Machado - Senior Full-Stack Engineer</title>
  <meta name="description" content="Portfolio of Gabriel Romay Machado, Senior Full-Stack Engineer with 10+ years of experience.">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header>
    <div class="container">
      {{ cv.personal | safe }}
    </div>
  </header>

  <main>
    <section id="summary">
      <div class="container">
        {{ cv.summary | safe }}
      </div>
    </section>

    <section id="experience">
      <div class="container">
        <h2>Work Experience</h2>
        {% for exp in cv.experience %}
        <article>{{ exp | safe }}</article>
        {% endfor %}
      </div>
    </section>

    <section id="skills">
      <div class="container">
        {{ cv.skills | safe }}
      </div>
    </section>

    <section id="education">
      <div class="container">
        {{ cv.education | safe }}
      </div>
    </section>

    <section id="languages">
      <div class="container">
        {{ cv.languages | safe }}
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>&copy; {{ cv.year }} Gabriel Romay Machado</p>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
